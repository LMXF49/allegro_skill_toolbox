FILE_TYPE=FORM_DEFN VERSION=2
FORM
FIXED
PORT 30 12
HEADER "Searcher Form"
TILE
TEXT "Input the object will be selected:"
TLOC 3 1
ENDTEXT
FIELD searchobject
FLOC 4 3
STRFILLIN 20 32
ENDFIELD

FIELD components
FLOC 4 5
CHECKLIST "Components" "alg"
ENDFIELD

FIELD nets
FLOC 17 5
CHECKLIST "Nets" "alg"
ENDFIELD

FIELD done
FLOC 4 7
MENUBUTTON "Next" 9 3
ENDFIELD

FIELD exit
FLOC 17 7
MENUBUTTON "Exit" 9 3
ENDFIELD

ENDTILE
ENDFORM
