FILE_TYPE=FORM_DEFN VERSION=2
FORM
FIXED
PORT 40 7
HEADER "Component Changes"

ACTIVEFIELD "old_name"

TILE
TEXT "Old Board:"
TLOC 4 2
ENDTEXT

TEXT "New Board:"
TLOC 4 5
ENDTEXT

FIELD old_name
FLOC 15 2
STRFILLIN 15 20
ENDFIELD

FIELD new_name
FLOC 15 5
STRFILLIN 15 20
ENDFIELD

FIELD changes_done
FLOC 6 9
MENUBUTTON "Done" 10 3
ENDFIELD

FIELD changes_cancel
FLOC 21 9
MENUBUTTON "Cancel" 10 3
ENDFIELD

ENDTILE

ENDFORM
