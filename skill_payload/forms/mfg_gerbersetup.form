FILE_TYPE=FORM_DEFN VERSION=2
FORM
FIXED
PORT 64 23
HEADER "文件输出"

POPUP <IPCPOP> "IPC-D-356A" "IPC-D-356A", "IPC-D-356" "IPC-D-356".

TILE

TEXT "输出路径:"
TLOC 2 1
ENDTEXT

FIELD outpath
FLOC 10 1
STRFILLIN 42 256
ENDFIELD

FIELD browse
FLOC 54 1
MENUBUTTON "选择" 6 2
ENDFIELD

GROUP "加工文件"
GLOC 2 3
GSIZE 60 15
ENDGROUP

FIELD chk_gerber
FLOC 4 5
CHECKLIST "光绘文件"
ENDFIELD

FIELD btn_artparam
FLOC 16 5
MENUBUTTON "定义参数" 9 2
ENDFIELD

FIELD btn_filmupd
FLOC 26 5
MENUBUTTON "创建/更新Film" 13 2
ENDFIELD

FIELD btn_artsetup
FLOC 41 5
MENUBUTTON "设置光绘" 10 2
ENDFIELD

FIELD chk_drill
FLOC 4 8
CHECKLIST "钻孔文件"
ENDFIELD

FIELD btn_ncparam
FLOC 16 8
MENUBUTTON "数控参数" 9 2
ENDFIELD

FIELD btn_ncsetup
FLOC 26 8
MENUBUTTON "设置钻孔" 10 2
ENDFIELD

FIELD btn_slotsetup
FLOC 37 8
MENUBUTTON "设置槽孔" 10 2
ENDFIELD

FIELD btn_legend
FLOC 48 8
MENUBUTTON "钻孔图例" 10 2
ENDFIELD

FIELD chk_coord
FLOC 4 11
CHECKLIST "坐标文件"
ENDFIELD

FIELD btn_dxf
FLOC 4 17
MENUBUTTON "输出DXF" 10 2
ENDFIELD

FIELD btn_step
FLOC 16 17
MENUBUTTON "输出3D(STEP)" 13 2
ENDFIELD

FIELD btn_dxfat
FLOC 31 17
MENUBUTTON "装配顶层DXF" 13 2
ENDFIELD

FIELD btn_dxfab
FLOC 46 17
MENUBUTTON "装配底层DXF" 13 2
ENDFIELD

TEXT "IPC Version:"
TLOC 16 11
ENDTEXT

FIELD ipc_ver
FLOC 30 11
ENUMSET 14
POP "IPCPOP"
ENDFIELD

TEXT "PDF输出:"
TLOC 4 14
ENDTEXT

FIELD btn_pdfasm
FLOC 16 14
MENUBUTTON "输出装配层PDF" 14 2
ENDFIELD

FIELD btn_pdfsilk
FLOC 32 14
MENUBUTTON "输出丝印层PDF" 14 2
ENDFIELD

FIELD btn_all
FLOC 4 20
MENUBUTTON "全部选择" 12 2
ENDFIELD

FIELD done
FLOC 22 20
MENUBUTTON "关闭" 10 2
ENDFIELD

FIELD btn_gen
FLOC 40 20
MENUBUTTON "生成加工文件" 16 2
ENDFIELD

ENDTILE

ENDFORM
